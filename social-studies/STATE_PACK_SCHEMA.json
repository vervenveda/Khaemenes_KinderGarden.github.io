{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khaemenesacademy.org/social-studies/state-pack.schema.json",
  "title": "Khaemenes Academy Social Studies State Pack",
  "type": "object",
  "required": [
    "schemaVersion",
    "stateCode",
    "stateName",
    "grade",
    "status",
    "geography",
    "indigenousNations",
    "chronology",
    "governmentConstitution",
    "civicInstitutions",
    "africanAmericanAndLocalContributors",
    "economy",
    "archivesMuseums",
    "sourceSets",
    "checkpointSubstitutions",
    "privacyAndNonpartisan"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "stateCode": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2
    },
    "stateName": {
      "type": "string"
    },
    "grade": {
      "type": [
        "string",
        "integer"
      ]
    },
    "status": {
      "enum": [
        "template",
        "validation",
        "complete"
      ]
    },
    "geography": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "indigenousNations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "chronology": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "governmentConstitution": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "civicInstitutions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "africanAmericanAndLocalContributors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "economy": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "archivesMuseums": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sourceSets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "checkpointSubstitutions": {
      "type": "object"
    },
    "privacyAndNonpartisan": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
